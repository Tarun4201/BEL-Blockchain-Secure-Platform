PORT=5001
NODE_ENV=production
CORS_ORIGIN=https://your-project.vercel.app

# Database (Turso libSQL for 24/7 persistence or SQLite fallback)
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
