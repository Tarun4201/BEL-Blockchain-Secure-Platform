# ====================================================================
# Bharat Electronics Limited (BEL) — Blockchain Platform Environment
# ====================================================================

# --------------------------------------------------------------------
# Server Configuration
# --------------------------------------------------------------------
PORT=5001
NODE_ENV=production
# Restrict CORS to your Vercel frontend URL in production (e.g., https://your-project.vercel.app)
CORS_ORIGIN=https://your-project.vercel.app

# --------------------------------------------------------------------
# Persistent Cloud Database (Turso / libSQL or local SQLite)
# --------------------------------------------------------------------
# For persistent 24/7 cloud deployment, provide Turso credentials:
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# If omitted, defaults to local SQLite file: backend/bel_platform.db
# SQLITE_PATH=./backend/bel_platform.db

# --------------------------------------------------------------------
# Blockchain Network Configuration
# --------------------------------------------------------------------
# For local development: http://127.0.0.1:8545
# For Polygon Amoy: https://rpc-amoy.polygon.technology
# For Ethereum Sepolia: https://rpc.sepolia.org or Alchemy/Infura URL
# For Base Sepolia: https://sepolia.base.org
RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_NETWORK_NAME="Polygon Amoy Testnet (ChainID: 80002)"
CHAIN_ID=80002
RPC_POLLING_INTERVAL=3000

# --------------------------------------------------------------------
# Deployed Smart Contract Addresses (Overrides backend/config/contracts.json)
# --------------------------------------------------------------------
# IDENTITY_REGISTRY_ADDRESS=0x...
# ACCESS_CONTROL_ADDRESS=0x...
# ASSET_REGISTRY_ADDRESS=0x...

# --------------------------------------------------------------------
# Persona Wallets & Signers (For Local Dev vs Production Testnet)
# NOTE: In production, generate fresh wallets and fund them with testnet faucet.
# --------------------------------------------------------------------
