# ============================================================
# BEL TrustGrid 2.0 — Environment Variables Template
# ============================================================
# Fill in your values after creating a Supabase project at:
# https://supabase.com/dashboard
# ============================================================

# --- Supabase (PUBLIC — safe to expose to browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Supabase (SERVER ONLY — never expose to browser) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Blockchain (Polygon Amoy primary, Sepolia fallback) ---
CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_RPC_FALLBACK_URL=https://rpc.sepolia.org
CHAIN_ID=80002
NEXT_PUBLIC_EXPLORER_BASE_URL=https://amoy.polygonscan.com

# --- Relayer (SERVER ONLY — testnet key only, never commit) ---
RELAYER_PRIVATE_KEY=YOUR_TESTNET_RELAYER_PRIVATE_KEY

# --- Smart Contract Addresses (fill after deployment) ---
CONTRACT_IDENTITY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_ACCESS_CONTROL_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_ASSET_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_DOCUMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_AUDIT_ANCHOR_ADDRESS=0x0000000000000000000000000000000000000000

# --- Demo (SERVER ONLY) ---
DEMO_PERSONA_PASSWORD=Demo@TrustGrid2026!
