# Public testnet deployment — do not put real values in this file or commit them.
NODE_ENV=production
RPC_URL=https://your-testnet-rpc.example
SEPOLIA_RPC_URL=https://your-testnet-rpc.example
DEPLOYER_PRIVATE_KEY=0xyour-funded-testnet-deployer-private-key
# Address of the independently controlled security-approval wallet. For this
# prototype it should be the address derived from SHARMA_PRIVATE_KEY.
SECURITY_APPROVER_ADDRESS=0xyour-independent-security-approver-address
ADMIN_PRIVATE_KEY=0xyour-admin-persona-private-key
SHARMA_PRIVATE_KEY=0xyour-r-sharma-demo-persona-private-key
VERMA_PRIVATE_KEY=0xyour-a-verma-demo-persona-private-key
BEL_DB_PATH=/var/data/bel_platform.db
